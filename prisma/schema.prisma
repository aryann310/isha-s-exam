generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  username      String?   @unique
  email         String    @unique
  passwordHash  String
  role          String    @default("STUDENT") // ADMIN or STUDENT
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  attempts      Attempt[]
  advisories    Advisory[]
  coachMessages CoachMessage[]

  // AI advisor chat: messages allowed per day (admins raise it on request), and when the student last asked.
  advisorDailyLimit       Int       @default(40)
  advisorLimitRequestedAt DateTime?

  // Notifications: everything sent before this moment counts as read (set when the student opens the bell).
  notificationsSeenAt     DateTime?
  notificationTargets     NotificationRecipient[]
}

model Exam {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  papers      Paper[]
}

model Paper {
  id                  String     @id @default(cuid())
  examId              String
  title               String
  year                Int
  shift               String?
  durationSeconds     Int
  totalQuestions      Int
  description         String?
  isActive            Boolean    @default(true)
  correctMarks        Float      @default(4.0)
  incorrectMarks      Float      @default(-1.0)
  unattemptedMarks    Float      @default(0.0)
  // Exam pattern preset: CAT | CMAT | NMAT | SNAP | CUSTOM (rules live in src/lib/exam-patterns.ts)
  examPattern         String     @default("CUSTOM")
  // JSON [{ "name": "VARC", "durationSeconds": 2400 }] in exam order; null = derive from questions
  sectionConfig       String?
  // Marks for typed-answer (TITA) questions; null = same as correctMarks
  titaCorrectMarks    Float?
  titaIncorrectMarks  Float      @default(0.0)
  // When students were told this paper is out (a PAPER notification). Null = not announced yet.
  announcedAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  exam                Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions           Question[]
  attempts            Attempt[]
  notification        Notification?
}

model Question {
  id              String         @id @default(cuid())
  paperId         String
  questionNumber  Int
  questionText    String
  section         String?
  topic           String?
  difficulty      String?        // Easy, Medium, Hard
  questionType    String         @default("MCQ") // MCQ | TITA (type in the answer)
  options         String         // Stored as JSON string e.g. {"A":"...","B":"..."}
  correctAnswer   String
  explanation     String?
  
  paper           Paper          @relation(fields: [paperId], references: [id], onDelete: Cascade)
  attemptAnswers  AttemptAnswer[]
  untimedAnswers  UntimedAnswer[]

  @@index([paperId, questionNumber])
}

model Attempt {
  id            String    @id @default(cuid())
  userId        String
  paperId       String
  mode          String    // PRACTICE or MOCK
  status        String    // IN_PROGRESS, SUBMITTED, AUTO_SUBMITTED
  startedAt     DateTime  @default(now())
  endsAt        DateTime?
  submittedAt   DateTime?
  score         Float?
  correct       Int?
  incorrect     Int?
  unattempted   Int?
  accuracy      Float?
  timeTaken     Int?      // In seconds
  // Sectional exams (CAT, NMAT): order the candidate takes sections in, and where they are now
  sectionOrder        String?   // JSON array of section names
  currentSection      Int       @default(0)
  sectionStartedAt    DateTime?
  sectionExtraSeconds Int       @default(0) // admin time extension for the current section
  // Untimed phase after a mock: the candidate may answer the questions left unanswered, with no time limit.
  // Those answers are kept apart (UntimedAnswer) and never change the score. Set when the phase is finished
  // or skipped; solutions stay hidden until then.
  untimedEndedAt      DateTime?
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper         Paper     @relation(fields: [paperId], references: [id], onDelete: Cascade)
  answers       AttemptAnswer[]
  untimedAnswers UntimedAnswer[]
  activity       AttemptActivity[]
  coachMessages  CoachMessage[]

  @@index([status])
  @@index([userId])
  @@index([paperId, status])
  @@index([startedAt])
}

model AttemptAnswer {
  id               String    @id @default(cuid())
  attemptId        String
  questionId       String
  selectedAnswer   String?
  isCorrect        Boolean?
  markedForReview  Boolean   @default(false)
  answeredAt       DateTime  @default(now())

  attempt          Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  @@unique([attemptId, questionId])
  @@index([questionId])
}

/// An answer given after the mock ended, in the untimed phase, to a question left unanswered in the test.
/// Correctness is worked out when shown (an answer-key fix then applies here too).
model UntimedAnswer {
  id             String   @id @default(cuid())
  attemptId      String
  questionId     String
  selectedAnswer String
  answeredAt     DateTime @default(now())

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

/// AI-written coaching advice for a student (Claude), one per scope: "all" tests or one exam's slug.
/// `basis` records which tests it covered; when new tests are finished the advice is offered for refresh.
model Advisory {
  id           String   @id @default(cuid())
  userId       String
  scope        String
  basis        String
  content      String // JSON, see src/server/advisor.ts
  model        String
  inputTokens  Int
  outputTokens Int
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope])
}

/// What the candidate did during a mock, sent from the test screen in batches: questions opened, options
/// clicked, saves, leaving the tab, idle time. `events` is a JSON array, see src/server/behaviour.ts.
model AttemptActivity {
  id        String   @id @default(cuid())
  attemptId String
  events    String
  createdAt DateTime @default(now())

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, createdAt])
}

/// "Talk to your advisor" chat after a test. Students can report a wrong answer for an admin to check.
model CoachMessage {
  id           String    @id @default(cuid())
  attemptId    String
  userId       String
  role         String // user | assistant
  content      String
  inputTokens  Int?
  outputTokens Int?
  reported     Boolean   @default(false)
  reportNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([attemptId, createdAt])
  @@index([userId, createdAt])
  @@index([reported])
}

/// A message in the students' bell. PAPER ones are sent automatically when a paper goes live (one per paper);
/// CUSTOM ones are written by an admin. Audience ALL = every student; SELECTED = the NotificationRecipient rows.
model Notification {
  id        String   @id @default(cuid())
  kind      String // PAPER | CUSTOM
  title     String
  body      String
  link      String? // a path in the portal ("/papers/…") or an https:// address
  paperId   String?  @unique
  audience  String   @default("ALL") // ALL | SELECTED
  createdBy String? // admin's name, for CUSTOM
  createdAt DateTime @default(now())

  paper      Paper?                  @relation(fields: [paperId], references: [id], onDelete: Cascade)
  recipients NotificationRecipient[]

  @@index([createdAt])
}

model NotificationRecipient {
  notificationId String
  userId         String

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId])
}
