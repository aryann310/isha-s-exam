{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "exam-portal",
	"main": ".open-next/worker.js",
	"compatibility_date": "2024-12-30",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "aiechocore.qzz.io",
			"custom_domain": true
		}
	]
}
